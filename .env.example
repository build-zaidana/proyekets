# === Agen Python (worker) ===
# Salin ke .env lalu isi. Dibaca oleh paket agent/.

# Provider LLM (aktifkan saat integrasi; worker jalan mode recon tanpa ini)
# LLM_PROVIDER=openai            # openai | gemini
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# Guardrail
ALLOWLIST_PATH=config/targets.allowlist
MAX_REQUESTS_PER_SECOND=3
MAX_AGENT_STEPS=25
HTTP_TIMEOUT_SECONDS=10
RESPONSE_BODY_MAX_BYTES=4096

# DB — kontrak dengan Laravel (DSN SQLAlchemy). Samakan database dengan Laravel.
AGENT_DB_DSN=mysql+mysqlconnector://autodast:secret@127.0.0.1:3306/autodast
WORKER_POLL_INTERVAL=2

# Output
AUDIT_LOG_PATH=audit/requests.jsonl

# === Catatan ===
# File .env Laravel TERPISAH, ada di web/.env (dibuat saat composer create-project).
# Pastikan DB_DATABASE/DB_USERNAME/DB_PASSWORD Laravel menunjuk DB yang sama dengan
# AGENT_DB_DSN di atas.
