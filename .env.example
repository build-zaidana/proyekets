# === Provider LLM (pilih salah satu) ===
LLM_PROVIDER=openai            # openai | gemini
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# === Guardrail ===
ALLOWLIST_PATH=config/targets.allowlist
MAX_REQUESTS_PER_SECOND=3       # rate limit tool HTTP
MAX_AGENT_STEPS=25              # batas iterasi reasoning loop
HTTP_TIMEOUT_SECONDS=10
RESPONSE_BODY_MAX_BYTES=4096    # potong body respons yang dikirim ke LLM

# === Output ===
AUDIT_LOG_PATH=audit/requests.jsonl
REPORT_DIR=reports
